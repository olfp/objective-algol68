# DATEI: shape_collection.oa68 #

# ========================================================================= #
# 1. BASISKLASSEN FÜR DIE DEMO                                              #
# ========================================================================= #

CLASS SHAPE = 
BEGIN
    INT x;
    INT y;

    PUB VIRTUAL METHOD init: (INT initx, INT inity) VOID: (
        x OF self := initx;
        y OF self := inity
    );

    PUB VIRTUAL METHOD name: STRING: (
        "Unbekannte Form"
    );
END;

CLASS CIRCLE EXTENDS SHAPE = 
BEGIN
    INT radius;

    PUB EXTEND METHOD init: (INT initx, INT inity, INT initr) VOID: (
        super SEND init(initx, inity);
        radius OF self := initr
    );

    PUB EXTEND METHOD name: STRING: (
        "Kreis"
    );
END;


# ========================================================================= #
# 2. DIE COLLECTION-KLASSEN (Knoten und Liste)                             #
# ========================================================================= #

# Ein einzelner Knoten der verketteten Liste #
CLASS SHAPENODE = 
BEGIN
    PUB SHAPE item;
    PUB SHAPENODE next; # Rekursive Referenz auf den nächsten Knoten #

    PUB METHOD init: (SHAPE newitem) VOID: (
        item OF self := newitem;
        next OF self := NIL  # NIL ist der Standard-Leerzeiger in Algol 68 #
    );
END;

# Die eigentliche Collection-Klasse #
CLASS SHAPECOLLECTION = 
BEGIN
    SHAPENODE head;
    INT count;

    PUB METHOD init: VOID: (
        head OF self := NIL;
        count OF self := 0
    );

    # Fügt ein neues Element am Anfang der Liste hinzu #
    PUB METHOD add: (SHAPE newitem) VOID: (
        SHAPENODE newnode := NEW SHAPENODE(newitem);
        next OF newnode := head OF self;
        head OF self := newnode;
        count OF self := (count OF self) + 1
    );

    # Gibt die aktuelle Anzahl der Elemente zurück #
    PUB METHOD size: INT: (
        count OF self
    );

    # Hilfsmethode: Gibt alle Elementnamen in der Collection aus #
    PUB METHOD print_all: VOID: (
        SHAPENODE current := head OF self;
        WHILE current ISNT NIL DO
            # Dynamic Dispatch: Ruft polymorph die korrekte name-Methode auf #
            puts(((item OF current) :: name, "'n"));
            current := next OF current
        OD
    );
END;


# ========================================================================= #
# 3. DAS ALGOL-68-HAUPTPROGRAMM                                             #
# ========================================================================= #
BEGIN
    # 1. Collection instanziieren #
    SHAPECOLLECTION my_list := NEW SHAPECOLLECTION;

    # 2. Polymorphe Objekte erzeugen und hinzufügen #
    # Da CIRCLE von SHAPE erbt, erlaubt der Präprozessor das Upcasting #
    my_list :: add(NEW CIRCLE(10, 20, 5));
    my_list :: add(NEW SHAPE(0, 0));
    my_list :: add(NEW CIRCLE(100, 100, 42));

    # 3. Collection-Informationen ausgeben #
    puts(("Anzahl der Elemente: ", my_list :: size, "'n"));
    puts(("Inhalt der Collection:'n", ));
    
    my_list :: print_all;
END
