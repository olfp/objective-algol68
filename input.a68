CLASS SHAPE = 
BEGIN
    INT x;
    INT y;

    VIRTUAL METHOD initX: (INT initX) y: (INT initY) VOID: (
        x OF self := initX;
        y OF self := initY
    );
END;

CLASS CIRCLE EXTENDS SHAPE = 
BEGIN
    INT radius;

    EXTEND METHOD initX: (INT initX) y: (INT initY) radius: (INT initR) VOID: (
        # Multi-argument upward VMT invocation #
        [SUPER initX: initX y: initY];
        radius OF self := initR
    );
END;

START = 
BEGIN
    REF CIRCLE myCircle := [CIRCLE new];
    [myCircle initX: 10 y: 20 radius: 5];
END

