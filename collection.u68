# DATEI: shape_collection.oa68 #

# ========================================================================= #
# 1. BASISKLASSEN FÜR DIE DEMO                                              #
# ========================================================================= #

𝐜𝐥𝐚𝐬𝐬 𝐬𝐡𝐚𝐩𝐞 = 
𝐛𝐞𝐠𝐢𝐧
    𝐢𝐧𝐭 𝑥;
    𝐢𝐧𝐭 𝑦;

    𝐩𝐮𝐛 𝐯𝐢𝐫𝐭𝐮𝐚𝐥 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: (𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑥, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑦) 𝐯𝐨𝐢𝐝: (
        𝑥 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑥;
        𝑦 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑦
    );

    𝐩𝐮𝐛 𝐯𝐢𝐫𝐭𝐮𝐚𝐥 𝐦𝐞𝐭𝐡𝐨𝐝 𝑛𝑎𝑚𝑒: 𝐬𝐭𝐫𝐢𝐧𝐠: (
        "Unbekannte Form"
    )
𝐞𝐧𝐝;

𝐜𝐥𝐚𝐬𝐬 𝐜𝐢𝐫𝐜𝐥𝐞 𝐞𝐱𝐭𝐞𝐧𝐝𝐬 𝐬𝐡𝐚𝐩𝐞 = 
𝐛𝐞𝐠𝐢𝐧
    𝐢𝐧𝐭 𝑟𝑎𝑑𝑖𝑢𝑠;

    𝐩𝐮𝐛 𝐞𝐱t𝐞𝐧𝐝 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: (𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑥, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑦, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑟) 𝐯𝐨𝐢𝐝: (
        𝑠𝑢𝑝𝑒𝑟 𝐬𝐞𝐧𝐝 𝑖𝑛𝑖𝑡(𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦);
        𝑟𝑎𝑑𝑖𝑢𝑠 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑟
    );

    𝐩𝐮𝐛 𝐞𝐱𝐭𝐞𝐧𝐝 𝐦𝐞𝐭𝐡𝐨𝐝 𝑛𝑎𝑚𝑒: 𝐬𝐭𝐫𝐢𝐧𝐠: (
        "Kreis"
    )
𝐞𝐧𝐝;


# ========================================================================= #
# 2. DIE COLLECTION-KLASSEN (Knoten und Liste)                             #
# ========================================================================= #

# Ein einzelner Knoten der verketteten Liste #
𝐜𝐥𝐚𝐬𝐬 𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞 = 
𝐛𝐞𝐠𝐢𝐧
    𝐩𝐮𝐛 𝐬𝐡𝐚𝐩𝐞 𝑖𝑡𝑒𝑚;
    𝐩𝐮𝐛 𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞 𝑛𝑒𝑥𝑡; # Rekursive Referenz auf den nächsten Knoten #

    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: (𝐬𝐡𝐚𝐩𝐞 𝑛𝑒𝑤𝑖𝑡𝑒𝑚) 𝐯𝐨𝐢𝐝: (
        𝑖𝑡𝑒𝑚 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑛𝑒𝑤𝑖𝑡𝑒𝑚;
        𝑛𝑒𝑥𝑡 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝐧𝐢𝐥  # NIL ist der Standard-Leerzeiger in Algol 68 #
    )
𝐞𝐧𝐝;

# Die eigentliche Collection-Klasse #
𝐜𝐥𝐚𝐬𝐬 𝐬𝐡𝐚𝐩𝐞𝐜𝐨𝐥𝐥𝐞𝐜𝐭𝐢𝐨𝐧 = 
𝐛𝐞𝐠𝐢𝐧
    𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞 ℎ𝑒𝑎𝑑;
    𝐢𝐧𝐭 𝑐𝑜𝑢𝑛𝑡;

    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: 𝐯𝐨𝐢𝐝: (
        ℎ𝑒𝑎𝑑 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝐧𝐢𝐥;
        𝑐𝑜𝑢𝑛𝑡 𝐨𝐟 𝑠𝑒𝑙𝑓 := 0
    );

    # Fügt ein neues Element am Anfang der Liste hinzu #
    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑎𝑑𝑑: (𝐬𝐡𝐚𝐩𝐞 𝑛𝑒𝑤𝑖𝑡𝑒𝑚) 𝐯𝐨𝐢𝐝: (
        𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞 𝑛𝑒𝑤𝑛𝑜𝑑𝑒 := 𝐧𝐞𝐰 𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞(𝑛𝑒𝑤𝑖𝑡𝑒𝑚);
        𝑛𝑒𝑥𝑡 𝐨𝐟 𝑛𝑒𝑤𝑛𝑜𝑑𝑒 := ℎ𝑒𝑎𝑑 𝐨𝐟 𝑠𝑒𝑙𝑓;
        ℎ𝑒𝑎𝑑 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑛𝑒𝑤𝑛𝑜𝑑𝑒;
        𝑐𝑜𝑢𝑛𝑡 𝐨𝐟 𝑠𝑒𝑙𝑓 := (𝑐𝑜𝑢𝑛𝑡 𝐨𝐟 𝑠𝑒𝑙𝑓) + 1
    );

    # Gibt die aktuelle Anzahl der Elemente zurück #
    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑠𝑖𝑧𝑒: 𝐢𝐧𝐭: (
        𝑐𝑜𝑢𝑛𝑡 𝐨𝐟 𝑠𝑒𝑙𝑓
    );

    # Hilfsmethode: Gibt alle Elementnamen in der Collection aus #
    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑝𝑟𝑖𝑛𝑡_𝑎𝑙𝑙: 𝐯𝐨𝐢𝐝: (
        𝐬𝐡𝐚𝐩𝐞𝐧𝐨𝐝𝐞 𝑐𝑢𝑟𝑟𝑒𝑛𝑡 := ℎ𝑒𝑎𝑑 𝐨𝐟 𝑠𝑒𝑙𝑓;
        𝐰𝐡𝐢𝐥𝐞 𝑐𝑢𝑟𝑟𝑒𝑛𝑡 𝐢𝐬𝐧𝐭 𝐫𝐞𝐟 𝐧𝐨𝐝𝐞(𝐧𝐢𝐥) 𝐝𝐨
            # Dynamic Dispatch: Ruft polymorph die korrekte name-Methode auf #
            𝑝𝑢𝑡𝑠(𝑖𝑡𝑒𝑚 𝐨𝐟 𝑐𝑢𝑟𝑟𝑒𝑛𝑡 :: 𝑛𝑎𝑚𝑒, "'n");
            𝑐𝑢𝑟𝑟𝑒𝑛𝑡 := 𝑛𝑒𝑥𝑡 𝐨𝐟 𝑐𝑢𝑟𝑟𝑒𝑛𝑡
        𝐨𝐝
    )
𝐞𝐧𝐝;


# ========================================================================= #
# 3. DAS ALGOL-68-HAUPTPROGRAMM                                             #
# ========================================================================= #
𝐛𝐞𝐠𝐢𝐧
    # 1. Collection instanziieren #
    𝐬𝐡𝐚𝐩𝐞𝐜𝐨𝐥𝐥𝐞𝐜𝐭𝐢𝐨𝐧 𝑚𝑦_𝑙𝑖𝑠𝑡 := 𝐧𝐞𝐰 𝐬𝐡𝐚𝐩𝐞𝐜𝐨𝐥𝐥𝐞𝐜𝐭𝐢𝐨𝐧;

    # 2. Polymorphe Objekte erzeugen und hinzufügen #
    # Da CIRCLE von SHAPE erbt, erlaubt der Präprozessor das Upcasting #
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐧𝐞𝐰 𝐜𝐢𝐫𝐜𝐥𝐞(10, 20, 5));
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐧𝐞𝐰 𝐬𝐡𝐚𝐩𝐞(0, 0));
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐧𝐞𝐰 𝐜𝐢𝐫𝐜𝐥𝐞(100, 100, 42));

    # 3. Collection-Informationen ausgeben #
    𝑝𝑢𝑡𝑠("Anzahl der Elemente: ", 𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑠𝑖𝑧𝑒, "'n");
    𝑝𝑢𝑡𝑠("Inhalt der Collection:'n");
    
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑝𝑟𝑖𝑛𝑡_𝑎𝑙𝑙;
𝐞𝐧𝐝
