# DATEI: shape_collection.oa68 #

# ========================================================================= #
# 1. BASISKLASSEN FÜR DIE DEMO                                              #
# ========================================================================= #

𝐂𝐋𝐀𝐒𝐒 𝐒𝐇𝐀𝐏𝐄 = 
𝐁𝐄𝐆𝐈𝐍
    𝐈𝐍𝐓 𝑥;
    𝐈𝐍𝐓 𝑦;

    𝐏𝐔𝐁 𝐕𝐈𝐑𝐓𝐔𝐀𝐋 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: (𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦) 𝐕𝐎𝐈𝐃: (
        𝑥 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑥;
        𝑦 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑦
    );

    𝐏𝐔𝐁 𝐕𝐈𝐑𝐓𝐔𝐀𝐋 𝐌𝐄𝐓𝐇𝐎𝐃 𝑛𝑎𝑚𝑒: 𝐒𝐓𝐑𝐈𝐍𝐆: (
        "Unbekannte Form"
    );
𝐄𝐍𝐃;

𝐂𝐋𝐀𝐒𝐒 𝐂𝐈𝐑𝐂𝐋𝐄 𝐄𝐗𝐓𝐄𝐍𝐃𝐒 𝐒𝐇𝐀𝐏𝐄 = 
𝐁𝐄𝐆𝐈𝐍
    𝐈𝐍𝐓 𝑟𝑎𝑑𝑖𝑢𝑠;

    𝐏𝐔𝐁 𝐄𝐗𝐓𝐄𝐍𝐃 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: (𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑟) 𝐕𝐎𝐈𝐃: (
        𝑠𝑢𝑝𝑒𝑟 𝐒𝐄𝐍𝐃 𝑖𝑛𝑖𝑡(𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦);
        𝑟𝑎𝑑𝑖𝑢𝑠 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑟
    );

    𝐏𝐔𝐁 𝐄𝐗𝐓𝐄𝐍𝐃 𝐌𝐄𝐓𝐇𝐎𝐃 𝑛𝑎𝑚𝑒: 𝐒𝐓𝐑𝐈𝐍𝐆: (
        "Kreis"
    );
𝐄𝐍𝐃;


# ========================================================================= #
# 2. DIE COLLECTION-KLASSEN (Knoten und Liste)                             #
# ========================================================================= #

# Ein einzelner Knoten der verketteten Liste #
𝐂𝐋𝐀𝐒𝐒 𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄 = 
𝐁𝐄𝐆𝐈𝐍
    𝐏𝐔𝐁 𝐒𝐇𝐀𝐏𝐄 𝑖𝑡𝑒𝑚;
    𝐏𝐔𝐁 𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄 𝑛𝑒𝑥𝑡; # Rekursive Referenz auf den nächsten Knoten #

    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: (𝐒𝐇𝐀𝐏𝐄 𝑛𝑒𝑤𝑖𝑡𝑒𝑚) 𝐕𝐎𝐈𝐃: (
        𝑖𝑡𝑒𝑚 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑛𝑒𝑤𝑖𝑡𝑒𝑚;
        𝑛𝑒𝑥𝑡 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝐍𝐈𝐋  # NIL ist der Standard-Leerzeiger in Algol 68 #
    );
𝐄𝐍𝐃;

# Die eigentliche Collection-Klasse #
𝐂𝐋𝐀𝐒𝐒 𝐒𝐇𝐀𝐏𝐄𝐂𝐎𝐋𝐋𝐄𝐂𝐓𝐈𝐎𝐍 = 
𝐁𝐄𝐆𝐈𝐍
    𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄 ℎ𝑒𝑎𝑑;
    𝐈𝐍𝐓 𝑐𝑜𝑢𝑛𝑡;

    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: 𝐕𝐎𝐈𝐃: (
        ℎ𝑒𝑎𝑑 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝐍𝐈𝐋;
        𝑐𝑜𝑢𝑛𝑡 𝐎𝐅 𝑠𝑒𝑙𝑓 := 0
    );

    # Fügt ein neues Element am Anfang der Liste hinzu #
    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑎𝑑𝑑: (𝐒𝐇𝐀𝐏𝐄 𝑛𝑒𝑤𝑖𝑡𝑒𝑚) 𝐕𝐎𝐈𝐃: (
        𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄 𝑛𝑒𝑤𝑛𝑜𝑑𝑒 := 𝐍𝐄𝐖 𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄(𝑛𝑒𝑤𝑖𝑡𝑒𝑚);
        𝑛𝑒𝑥𝑡 𝐎𝐅 𝑛𝑒𝑤𝑛𝑜𝑑𝑒 := ℎ𝑒𝑎𝑑 𝐎𝐅 𝑠𝑒𝑙𝑓;
        ℎ𝑒𝑎𝑑 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑛𝑒𝑤𝑛𝑜𝑑𝑒;
        𝑐𝑜𝑢𝑛𝑡 𝐎𝐅 𝑠𝑒𝑙𝑓 := (𝑐𝑜𝑢𝑛𝑡 𝐎𝐅 𝑠𝑒𝑙𝑓) + 1
    );

    # Gibt die aktuelle Anzahl der Elemente zurück #
    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑠𝑖𝑧𝑒: 𝐈𝐍𝐓: (
        𝑐𝑜𝑢𝑛𝑡 𝐎𝐅 𝑠𝑒𝑙𝑓
    );

    # Hilfsmethode: Gibt alle Elementnamen in der Collection aus #
    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑝𝑟𝑖𝑛𝑡_𝑎𝑙𝑙: 𝐕𝐎𝐈𝐃: (
        𝐒𝐇𝐀𝐏𝐄𝐍𝐎𝐃𝐄 𝑐𝑢𝑟𝑟𝑒𝑛𝑡 := ℎ𝑒𝑎𝑑 𝐎𝐅 𝑠𝑒𝑙𝑓;
        𝐖𝐇𝐈𝐋𝐄 𝑐𝑢𝑟𝑟𝑒𝑛𝑡 𝐈𝐒𝐍𝐓 𝐍𝐈𝐋 𝐃𝐎
            # Dynamic Dispatch: Ruft polymorph die korrekte name-Methode auf #
            𝑝𝑢𝑡𝑠(((𝑖𝑡𝑒𝑚 𝐎𝐅 𝑐𝑢𝑟𝑟𝑒𝑛𝑡) :: 𝑛𝑎𝑚𝑒, "'n"));
            𝑐𝑢𝑟𝑟𝑒𝑛𝑡 := 𝑛𝑒𝑥𝑡 𝐎𝐅 𝑐𝑢𝑟𝑟𝑒𝑛𝑡
        𝐎𝐃
    );
𝐄𝐍𝐃;


# ========================================================================= #
# 3. DAS ALGOL-68-HAUPTPROGRAMM                                             #
# ========================================================================= #
𝐁𝐄𝐆𝐈𝐍
    # 1. Collection instanziieren #
    𝐒𝐇𝐀𝐏𝐄𝐂𝐎𝐋𝐋𝐄𝐂𝐓𝐈𝐎𝐍 𝑚𝑦_𝑙𝑖𝑠𝑡 := 𝐍𝐄𝐖 𝐒𝐇𝐀𝐏𝐄𝐂𝐎𝐋𝐋𝐄𝐂𝐓𝐈𝐎𝐍;

    # 2. Polymorphe Objekte erzeugen und hinzufügen #
    # Da CIRCLE von SHAPE erbt, erlaubt der Präprozessor das Upcasting #
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐍𝐄𝐖 𝐂𝐈𝐑𝐂𝐋𝐄(10, 20, 5));
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐍𝐄𝐖 𝐒𝐇𝐀𝐏𝐄(0, 0));
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑎𝑑𝑑(𝐍𝐄𝐖 𝐂𝐈𝐑𝐂𝐋𝐄(100, 100, 42));

    # 3. Collection-Informationen ausgeben #
    𝑝𝑢𝑡𝑠(("Anzahl der Elemente: ", 𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑠𝑖𝑧𝑒, "'n"));
    𝑝𝑢𝑡𝑠(("Inhalt der Collection:'n", ));
    
    𝑚𝑦_𝑙𝑖𝑠𝑡 :: 𝑝𝑟𝑖𝑛𝑡_𝑎𝑙𝑙;
𝐄𝐍𝐃
