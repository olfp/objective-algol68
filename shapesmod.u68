# DATEI: shapesmod.o68 #
𝐌𝐎𝐃𝐔𝐋𝐄 𝑠ℎ𝑎𝑝𝑒𝑠𝑚𝑜𝑑 =
𝐃𝐄𝐅

𝐏𝐔𝐁 𝐂𝐋𝐀𝐒𝐒 𝐒𝐇𝐀𝐏𝐄 = 
𝐁𝐄𝐆𝐈𝐍
    𝐈𝐍𝐓 𝑥;
    𝐈𝐍𝐓 𝑦;

    𝐏𝐔𝐁 𝐕𝐈𝐑𝐓𝐔𝐀𝐋 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: (𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦) 𝐕𝐎𝐈𝐃: (
        𝑥 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑥;
        𝑦 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑦
    );

    𝐏𝐔𝐁 𝐕𝐈𝐑𝐓𝐔𝐀𝐋 𝐌𝐄𝐓𝐇𝐎𝐃 𝑝𝑟𝑖𝑛𝑡_𝑎𝑟𝑒𝑎: 𝐕𝐎𝐈𝐃: (
        𝑝𝑟𝑖𝑛𝑡(("Keine Flaeche fuer unbestimmte Form", 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );
𝐄𝐍𝐃;

𝐏𝐔𝐁 𝐂𝐋𝐀𝐒𝐒 𝐂𝐈𝐑𝐂𝐋𝐄 𝐄𝐗𝐓𝐄𝐍𝐃𝐒 𝐒𝐇𝐀𝐏𝐄 = 
𝐁𝐄𝐆𝐈𝐍
    𝐏𝐔𝐁 𝐈𝐍𝐓 𝑟𝑎𝑑𝑖𝑢𝑠;

    𝐏𝐔𝐁 𝐄𝐗𝐓𝐄𝐍𝐃 𝐌𝐄𝐓𝐇𝐎𝐃 𝑖𝑛𝑖𝑡: (𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑟) 𝐕𝐎𝐈𝐃: (
        𝑠𝑢𝑝𝑒𝑟 𝐒𝐄𝐍𝐃 𝑖𝑛𝑖𝑡(𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦);
        𝑟𝑎𝑑𝑖𝑢𝑠 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑟
    );

    # Parameterloser Aufruf via Deproceduring #
    𝐏𝐔𝐁 𝐌𝐄𝐓𝐇𝐎𝐃 𝑎𝑟𝑒𝑎: 𝐑𝐄𝐀𝐋: (
        𝑝𝑖 * (𝑟𝑎𝑑𝑖𝑢𝑠 𝐎𝐅 𝑠𝑒𝑙𝑓) ** 2
    );

    𝐏𝐔𝐁 𝐄𝐗𝐓𝐄𝐍𝐃 𝐌𝐄𝐓𝐇𝐎𝐃 𝑝𝑟𝑖𝑛𝑡_𝑎𝑟𝑒𝑎: 𝐕𝐎𝐈𝐃: (
        𝑝𝑟𝑖𝑛𝑡(("Kreisflaeche: ", 𝑠𝑒𝑙𝑓 :: 𝑎𝑟𝑒𝑎, 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );
𝐄𝐍𝐃;

𝐅𝐄𝐃
