# GENERIERTE DATEI: shapesmod.a68 #
𝐌𝐎𝐃𝐔𝐋𝐄 𝑠ℎ𝑎𝑝𝑒𝑠𝑚𝑜𝑑 =
𝐃𝐄𝐅

    # ========================================== #
    # 1. TYP-DEFINITIONEN (MODES ALS BOLD-WORDS) #
    # ========================================== #
    
    # Vorwärtsdeklaration der Datenstrukturen für die VMT-Typen #
    𝐌𝐎𝐃𝐄 𝐒𝐇𝐀𝐏𝐄𝐎𝐁𝐉 = 𝐒𝐓𝐑𝐔𝐂𝐓(𝐑𝐄𝐅 𝐒𝐇𝐀𝐏𝐄𝐕𝐌𝐓 𝑣𝑚𝑡, 𝐈𝐍𝐓 𝑥, 𝐈𝐍𝐓 𝑦);
    𝐌𝐎𝐃𝐄 𝐒𝐇𝐀𝐏𝐄 = 𝐑𝐄𝐅 𝐒𝐇𝐀𝐏𝐄𝐎𝐁𝐉;

    𝐌𝐎𝐃𝐄 𝐒𝐇𝐀𝐏𝐄𝐕𝐌𝐓 = 𝐒𝐓𝐑𝐔𝐂𝐓(
        𝐑𝐄𝐅 𝐏𝐑𝐎𝐂(𝐒𝐇𝐀𝐏𝐄, 𝐈𝐍𝐓, 𝐈𝐍𝐓) 𝐕𝐎𝐈𝐃 𝑖𝑛𝑖𝑡,
        𝐑𝐄𝐅 𝐏𝐑𝐎𝐂(𝐒𝐇𝐀𝐏𝐄) 𝐕𝐎𝐈𝐃 𝑝𝑟𝑖𝑛𝑡𝑎𝑟𝑒𝑎
    );

    𝐌𝐎𝐃𝐄 𝐂𝐈𝐑𝐂𝐋𝐄𝐎𝐁𝐉 = 𝐒𝐓𝐑𝐔𝐂𝐓(
        𝐒𝐇𝐀𝐏𝐄𝐎𝐁𝐉 𝑏𝑎𝑠𝑒, # Vererbung durch Einbettung #
        𝐈𝐍𝐓 𝑟𝑎𝑑𝑖𝑢𝑠
    );
    𝐌𝐎𝐃𝐄 𝐂𝐈𝐑𝐂𝐋𝐄 = 𝐑𝐄𝐅 𝐂𝐈𝐑𝐂𝐋𝐄𝐎𝐁𝐉;


    # ========================================== #
    # 2. METHODEN-IMPLEMENTIERUNGEN             #
    # ========================================== #

    # SHAPE::INIT #
    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑠ℎ𝑎𝑝𝑒𝑖𝑛𝑖𝑡 = (𝐒𝐇𝐀𝐏𝐄 𝑠𝑒𝑙𝑓, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦) 𝐕𝐎𝐈𝐃: (
        𝑥 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑥;
        𝑦 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑦
    );

    # SHAPE::PRINTAREA #
    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑠ℎ𝑎𝑝𝑒𝑝𝑟𝑖𝑛𝑡𝑎𝑟𝑒𝑎 = (𝐒𝐇𝐀𝐏𝐄 𝑠𝑒𝑙𝑓) 𝐕𝐎𝐈𝐃: (
        𝑝𝑟𝑖𝑛𝑡(("Keine Flaeche fuer unbestimmte Form", 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );

    # CIRCLE::INIT #
    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑐𝑖𝑟𝑐𝑙𝑒𝑖𝑛𝑖𝑡 = (𝐂𝐈𝐑𝐂𝐋𝐄 𝑠𝑒𝑙𝑓, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑟) 𝐕𝐎𝐈𝐃: (
        # super SEND init(...) wird zu direktem Basisaufruf #
        𝑠ℎ𝑎𝑝𝑒𝑖𝑛𝑖𝑡(𝑏𝑎𝑠𝑒 𝐎𝐅 𝑠𝑒𝑙𝑓, 𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦);
        𝑟𝑎𝑑𝑖𝑢𝑠 𝐎𝐅 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑟
    );

    # CIRCLE::AREA (Parameterlos -> wird via Deproceduring aufgerufen) #
    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑐𝑖𝑟𝑐𝑙𝑒𝑎𝑟𝑒𝑎 = (𝐂𝐈𝐑𝐂𝐋𝐄 𝑠𝑒𝑙𝑓) 𝐑𝐄𝐀𝐋: (
        𝑝𝑖 * (𝑟𝑎𝑑𝑖𝑢𝑠 𝐎𝐅 𝑠𝑒𝑙𝑓) ** 2
    );

    # CIRCLE::PRINTAREA (Überschreibt SHAPE::PRINTAREA) #
    # Akzeptiert SHAPE als Typ, um in der SHAPEVMT kompatibel zu sein #
    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑐𝑖𝑟𝑐𝑙𝑒𝑝𝑟𝑖𝑛𝑡𝑎𝑟𝑒𝑎 = (𝐒𝐇𝐀𝐏𝐄 𝑠𝑒𝑙𝑓) 𝐕𝐎𝐈𝐃: (
        # Erlaubtes, echtes Algol-68-Casting zurück zum CIRCLE #
        𝐂𝐈𝐑𝐂𝐋𝐄 𝑐𝑠𝑒𝑙𝑓 = 𝐂𝐈𝐑𝐂𝐋𝐄(𝑠𝑒𝑙𝑓);
        
        # Aufruf der parameterlosen Prozedur circlearea #
        𝑝𝑟𝑖𝑛𝑡(("Kreisflaeche: ", 𝑐𝑖𝑟𝑐𝑙𝑒𝑎𝑟𝑒𝑎(𝑐𝑠𝑒𝑙𝑓), 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );


    # ========================================== #
    # 3. VMT-INITIALISIERUNG                    #
    # ========================================== #

    𝐒𝐇𝐀𝐏𝐄𝐕𝐌𝐓 𝑔𝑙𝑜𝑏𝑎𝑙𝑠ℎ𝑎𝑝𝑒𝑠𝑣𝑚𝑡  := (𝑠ℎ𝑎𝑝𝑒𝑖𝑛𝑖𝑡, 𝑠ℎ𝑎𝑝𝑒𝑝𝑟𝑖𝑛𝑡𝑎𝑟𝑒𝑎);
    
    # CIRCLE nutzt für geerbte/überschriebene virtuelle Methoden die SHAPEVMT-Struktur #
    𝐒𝐇𝐀𝐏𝐄𝐕𝐌𝐓 𝑔𝑙𝑜𝑏𝑎𝑙𝑐𝑖𝑟𝑐𝑙𝑒𝑣𝑚𝑡  := (𝑠ℎ𝑎𝑝𝑒𝑖𝑛𝑖𝑡, 𝑐𝑖𝑟𝑐𝑙𝑒𝑝𝑟𝑖𝑛𝑡𝑎𝑟𝑒𝑎); 


    # ========================================== #
    # 4. NEW-OPERATOREN (KONSTRUKTOREN)         #
    # ========================================== #

    𝐏𝐔𝐁 𝐏𝐑𝐎𝐂 𝑛𝑒𝑤𝑐𝑖𝑟𝑐𝑙𝑒 = (𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑥, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑦, 𝐈𝐍𝐓 𝑖𝑛𝑖𝑡𝑟) 𝐂𝐈𝐑𝐂𝐋𝐄: (
        𝐂𝐈𝐑𝐂𝐋𝐄 𝑖𝑛𝑠𝑡𝑎𝑛𝑐𝑒 := 𝐇𝐄𝐀𝐏 𝐂𝐈𝐑𝐂𝐋𝐄𝐎𝐁𝐉;
        𝑣𝑚𝑡 𝐎𝐅 𝑏𝑎𝑠𝑒 𝐎𝐅 𝑖𝑛𝑠𝑡𝑎𝑛𝑐𝑒 := 𝑔𝑙𝑜𝑏𝑎𝑙𝑐𝑖𝑟𝑐𝑙𝑒𝑣𝑚𝑡;
        𝑐𝑖𝑟𝑐𝑙𝑒𝑖𝑛𝑖𝑡(𝑖𝑛𝑠𝑡𝑎𝑛𝑐𝑒, 𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦, 𝑖𝑛𝑖𝑡𝑟);
        𝑖𝑛𝑠𝑡𝑎𝑛𝑐𝑒
    );

𝐅𝐄𝐃

