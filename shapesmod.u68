# DATEI: shapesmod.o68 #
𝐦𝐨𝐝𝐮𝐥𝐞 𝑠ℎ𝑎𝑝𝑒𝑠𝑚𝑜𝑑 =
𝐝𝐞𝐟

𝐩𝐮𝐛 𝐜𝐥𝐚𝐬𝐬 𝐬𝐡𝐚𝐩𝐞 = 
𝐛𝐞𝐠𝐢𝐧
    𝐢𝐧𝐭 𝑥;
    𝐢𝐧𝐭 𝑦;

    𝐩𝐮𝐛 𝐯𝐢𝐫𝐭𝐮𝐚𝐥 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: (𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑥, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑦) 𝐯𝐨𝐢𝐝: (
        𝑥 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑥;
        𝑦 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑦
    );

    𝐩𝐮𝐛 𝐯𝐢𝐫𝐭𝐮𝐚𝐥 𝐦𝐞𝐭𝐡𝐨𝐝 𝑝𝑟𝑖𝑛𝑡_𝑎𝑟𝑒𝑎: 𝐯𝐨𝐢𝐝: (
        𝑝𝑟𝑖𝑛𝑡(("Keine Flaeche fuer unbestimmte Form", 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );
𝐞𝐧𝐝;

𝐩𝐮𝐛 𝐜𝐥𝐚𝐬𝐬 𝐜𝐢𝐫𝐜𝐥𝐞 𝐞𝐱𝐭𝐞𝐧𝐝𝐬 𝐬𝐡𝐚𝐩𝐞 = 
𝐛𝐞𝐠𝐢𝐧
    𝐩𝐮𝐛 𝐢𝐧𝐭 𝑟𝑎𝑑𝑖𝑢𝑠;

    𝐩𝐮𝐛 𝐞𝐱𝐭𝐞𝐧𝐝 𝐦𝐞𝐭𝐡𝐨𝐝 𝑖𝑛𝑖𝑡: (𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑥, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑦, 𝐢𝐧𝐭 𝑖𝑛𝑖𝑡𝑟) 𝐯𝐨𝐢𝐝: (
        𝑠𝑢𝑝𝑒𝑟 𝐬𝐞𝐧𝐝 𝑖𝑛𝑖𝑡(𝑖𝑛𝑖𝑡𝑥, 𝑖𝑛𝑖𝑡𝑦);
        𝑟𝑎𝑑𝑖𝑢𝑠 𝐨𝐟 𝑠𝑒𝑙𝑓 := 𝑖𝑛𝑖𝑡𝑟
    );

    # Parameterloser Aufruf via Deproceduring #
    𝐩𝐮𝐛 𝐦𝐞𝐭𝐡𝐨𝐝 𝑎𝑟𝑒𝑎: 𝐫𝐞𝐚𝐥: (
        𝑝𝑖 * (𝑟𝑎𝑑𝑖𝑢𝑠 𝐨𝐟 𝑠𝑒𝑙𝑓) ** 2
    );

    𝐩𝐮𝐛 𝐞𝐱𝐭𝐞𝐧𝐝 𝐦𝐞𝐭𝐡𝐨𝐝 𝑝𝑟𝑖𝑛𝑡_𝑎𝑟𝑒𝑎: 𝐯𝐨𝐢𝐝: (
        𝑝𝑟𝑖𝑛𝑡(("Kreisflaeche: ", 𝑠𝑒𝑙𝑓 :: 𝑎𝑟𝑒𝑎, 𝑛𝑒𝑤𝑙𝑖𝑛𝑒))
    );
𝐞𝐧𝐝;

𝐟𝐞𝐝
