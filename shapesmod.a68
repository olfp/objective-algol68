# GENERIERTE DATEI: shapesmod.a68 #
MODULE shapesmod =
DEF

    # ========================================== #
    # 1. TYP-DEFINITIONEN (MODES ALS BOLD-WORDS) #
    # ========================================== #
    
    # Vorwärtsdeklaration der Datenstrukturen für die VMT-Typen #
    MODE SHAPEOBJ = STRUCT(REF SHAPEVMT vmt, INT x, INT y);
    MODE SHAPE = REF SHAPEOBJ;

    MODE SHAPEVMT = STRUCT(
        REF PROC(SHAPE, INT, INT) VOID init,
        REF PROC(SHAPE) VOID printarea
    );

    MODE CIRCLEOBJ = STRUCT(
        SHAPEOBJ base, # Vererbung durch Einbettung #
        INT radius
    );
    MODE CIRCLE = REF CIRCLEOBJ;


    # ========================================== #
    # 2. METHODEN-IMPLEMENTIERUNGEN             #
    # ========================================== #

    # SHAPE::INIT #
    PUB PROC shapeinit = (SHAPE self, INT initx, INT inity) VOID: (
        x OF self := initx;
        y OF self := inity
    );

    # SHAPE::PRINTAREA #
    PUB PROC shapeprintarea = (SHAPE self) VOID: (
        print(("Keine Flaeche fuer unbestimmte Form", newline))
    );

    # CIRCLE::INIT #
    PUB PROC circleinit = (CIRCLE self, INT initx, INT inity, INT initr) VOID: (
        # super SEND init(...) wird zu direktem Basisaufruf #
        shapeinit(base OF self, initx, inity);
        radius OF self := initr
    );

    # CIRCLE::AREA (Parameterlos -> wird via Deproceduring aufgerufen) #
    PUB PROC circlearea = (CIRCLE self) REAL: (
        pi * (radius OF self) ** 2
    );

    # CIRCLE::PRINTAREA (Überschreibt SHAPE::PRINTAREA) #
    # Akzeptiert SHAPE als Typ, um in der SHAPEVMT kompatibel zu sein #
    PUB PROC circleprintarea = (SHAPE self) VOID: (
        # Erlaubtes, echtes Algol-68-Casting zurück zum CIRCLE #
        CIRCLE cself = CIRCLE(self);
        
        # Aufruf der parameterlosen Prozedur circlearea #
        print(("Kreisflaeche: ", circlearea(cself), newline))
    );


    # ========================================== #
    # 3. VMT-INITIALISIERUNG                    #
    # ========================================== #

    SHAPEVMT globalshapesvmt  := (shapeinit, shapeprintarea);
    
    # CIRCLE nutzt für geerbte/überschriebene virtuelle Methoden die SHAPEVMT-Struktur #
    SHAPEVMT globalcirclevmt  := (shapeinit, circleprintarea); 


    # ========================================== #
    # 4. NEW-OPERATOREN (KONSTRUKTOREN)         #
    # ========================================== #

    PUB PROC newcircle = (INT initx, INT inity, INT initr) CIRCLE: (
        CIRCLE instance := HEAP CIRCLEOBJ;
        vmt OF base OF instance := globalcirclevmt;
        circleinit(instance, initx, inity, initr);
        instance
    );

FED

