# DATEI: shapesmod.o68 #
MODULE shapesmod =
DEF

PUB CLASS SHAPE = 
BEGIN
    INT x;
    INT y;

    PUB VIRTUAL METHOD init: (INT initx, INT inity) VOID: (
        x OF self := initx;
        y OF self := inity
    );

    PUB VIRTUAL METHOD print_area: VOID: (
        print(("Keine Flaeche fuer unbestimmte Form", newline))
    );
END;

PUB CLASS CIRCLE EXTENDS SHAPE = 
BEGIN
    PUB INT radius;

    PUB EXTEND METHOD init: (INT initx, INT inity, INT initr) VOID: (
        super SEND init(initx, inity);
        radius OF self := initr
    );

    # Parameterloser Aufruf via Deproceduring #
    PUB METHOD area: REAL: (
        pi * (radius OF self) ** 2
    );

    PUB EXTEND METHOD print_area: VOID: (
        print(("Kreisflaeche: ", self :: area, newline))
    );
END;

FED
